---
import Base from '../layouts/Base.astro';
import Portrait from '../components/Portrait.astro';
import PostList from '../components/PostList.astro';
import AiNote from '../components/AiNote.astro';
import { getPosts } from '../lib/collections';

// Posts marked `featured: true` (newest first, up to 3).
// Until any are marked, fall back to the 3 most recent so the section isn't empty.
const allPosts = await getPosts();
const featured = allPosts.filter((p) => p.data.featured);
const posts = (featured.length ? featured : allPosts).slice(0, 3);
---

<Base>
  <script is:inline>
    // Play the entrance animation only on the first home visit of a session.
    try {
      if (sessionStorage.getItem('intro-seen')) document.documentElement.classList.add('intro-seen');
      else sessionStorage.setItem('intro-seen', '1');
    } catch {}
  </script>
  <section class="hero column">
    <div class="seal"><Portrait size={96} /></div>
    <h1>Engineering @ Meta, former product & growth lead</h1>
    <p class="lede">
      Currently building AI inference infrastructure at Meta. Previously as a product & growth lead, I scaled a product from
      500K to 1.2M users and 2x revenue in under a year. I've also created educational tech videos with 5M+ views on YouTube.
    </p>
    {
      posts.length > 0 && (
        <p class="lede">
          Sharing my insights on tech, AI, and career growth here.
          <a href="/insights" class="pill inline-pill">
            All insights
            <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.3"></path>
            </svg>
          </a>
        </p>
      )
    }
  </section>

  <hr class="rule" />

  {
    posts.length > 0 && (
      <section class="list column">
        <h2 class="recent">Featured</h2>
        <PostList posts={posts} />
        <AiNote />
      </section>
    )
  }
</Base>

<style>
  .hero {
    padding-top: 40px;
    padding-bottom: 36px;
    text-align: center;
  }
  .seal {
    display: flex;
    justify-content: center;
    margin-bottom: 28px;
  }
  h1 {
    font-size: 30px;
    line-height: 1.2;
    max-width: 440px;
    margin: 0 auto;
  }
  .lede + .lede {
    margin-top: 16px;
  }
  /* Button sitting inline at the end of the second paragraph */
  .inline-pill {
    /* negative vertical margins keep the button from stretching the line */
    margin: -4px 0 -4px 6px;
    padding: 6px 10px 6px 13px;
    vertical-align: 1px;
    white-space: nowrap;
  }
  .lede {
    margin-top: 36px;
    font-family: var(--serif);
    font-size: 18px;
    line-height: 1.4;
    text-align: left;
    text-wrap: pretty;
  }
  .recent {
    font-size: 19px;
    line-height: 1.25;
    margin-bottom: 8px;
  }
  .list {
    padding-top: 32px;
  }
  .list:last-child {
    padding-bottom: 72px;
  }
  /* Page-load entrance: each block fades up in turn */
  @media (prefers-reduced-motion: no-preference) {
    :global(html:not(.intro-seen)) .seal,
    :global(html:not(.intro-seen)) h1,
    :global(html:not(.intro-seen)) .lede,
    :global(html:not(.intro-seen)) .rule,
    :global(html:not(.intro-seen)) .list {
      animation: rise 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }
    :global(html:not(.intro-seen)) .seal {
      animation-name: settle;
    }
    :global(html:not(.intro-seen)) h1 {
      animation-delay: 0.1s;
    }
    :global(html:not(.intro-seen)) .lede {
      animation-delay: 0.2s;
    }
    :global(html:not(.intro-seen)) .rule {
      animation-name: fade;
      animation-delay: 0.4s;
    }
    :global(html:not(.intro-seen)) .list {
      animation-delay: 0.45s;
    }
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }
  @keyframes settle {
    from {
      opacity: 0;
      transform: scale(0.94);
    }
  }
  @keyframes fade {
    from {
      opacity: 0;
    }
  }
  @media (max-width: 560px) {
    h1 {
      font-size: 25px;
    }
    .lede {
      margin-top: 28px;
      font-size: 17px;
    }
  }
</style>
