---
import { render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { formatMonth } from '../lib/site';

interface Props {
  entries: CollectionEntry<'journey'>[];
}

const { entries } = Astro.props;

// "Company Name" -> "CN", "Acme" -> "AC"
const initials = (name: string) => {
  const words = name.split(/\s+/).filter(Boolean);
  const letters = words.length > 1 ? words[0][0] + words[1][0] : name.slice(0, 2);
  return letters.toUpperCase();
};

// youtube.com/watch?v=ID, youtu.be/ID or /embed/ID -> ID
const youtubeId = (url: string) =>
  url.match(/(?:v=|youtu\.be\/|embed\/|shorts\/)([\w-]{11})/)?.[1] ?? '';

const items = await Promise.all(
  entries.map(async (entry) => {
    const { Content } = await render(entry);
    const { start, end, current } = entry.data;
    return {
      entry,
      Content,
      from: formatMonth(start),
      to: end ? formatMonth(end) : current ? 'Present' : null,
      roles: entry.data.roles?.map((role) => ({
        ...role,
        from: formatMonth(role.start),
        to: role.end ? formatMonth(role.end) : 'Present',
      })),
    };
  }),
);
---

<ol class="timeline" id="timeline">
  {
    items.map(({ entry, Content, from, to, roles }) => {
      const { title, org, orgUrl, logo, location, current, media } = entry.data;
      return (
        <li class:list={['item', { current }]}>
          <div class="when">
            <time datetime={entry.data.start.toISOString()}>{from}</time>
            {to && <span class="to">– {to}</span>}
          </div>
          <div class="marker" aria-hidden="true">
            {logo ? (
              <Image src={logo} alt="" width={80} height={80} class="logo" />
            ) : roles ? (
              <span class="initials">
                {/* briefcase */}
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="7" width="18" height="13" rx="2" />
                  <path d="M9 7V5.5A1.5 1.5 0 0 1 10.5 4h3A1.5 1.5 0 0 1 15 5.5V7" />
                  <path d="M3 12.5h18" />
                </svg>
              </span>
            ) : (
              <span class="initials">{initials(org ?? title)}</span>
            )}
          </div>
          <div class="what">
            <h2 class="title">{title}</h2>
            <p class="org">
              {roles ? `${roles.length} roles` : orgUrl ? <a href={orgUrl}>{org}</a> : org}
              {location && <span> · {location}</span>}
            </p>
            <div class="desc">
              <Content />
            </div>
            {media && (
              <ul class="media">
                {media.map((video) => {
                  const id = youtubeId(video.youtube);
                  return (
                    <li>
                      <a class="sample" href={video.youtube} target="_blank" rel="noopener">
                        <span class="video">
                          <img
                            src={`https://i.ytimg.com/vi/${id}/maxresdefault.jpg`}
                            alt=""
                            loading="lazy"
                            width="1280"
                            height="720"
                            onerror={`this.onerror=null;this.src='https://i.ytimg.com/vi/${id}/hqdefault.jpg'`}
                          />
                          <span class="play" aria-hidden="true">
                            <svg viewBox="0 0 24 24" width="12" height="12"><path d="M8 5.5v13l10.5-6.5z" fill="currentColor" /></svg>
                          </span>
                        </span>
                        <span class="caption">
                          {video.caption}
                          <span class="visually-hidden"> (opens {video.title} on YouTube)</span>
                        </span>
                      </a>
                    </li>
                  );
                })}
              </ul>
            )}
            {roles && (
              <ul class="roles">
                {roles.map((role) => (
                  <li class="role" style={`--i:${roles.indexOf(role)}`}>
                    <span class="role-logo" aria-hidden="true">
                      {role.logo ? (
                        <Image src={role.logo} alt="" width={56} height={56} class="logo" />
                      ) : (
                        <span class="initials">{initials(role.org)}</span>
                      )}
                    </span>
                    <div>
                      <p class="role-head">
                        <span class="role-org">
                          {role.orgUrl ? <a href={role.orgUrl}>{role.org}</a> : role.org}
                        </span>
                        <span class="role-when">
                          {role.from} – {role.to}
                        </span>
                      </p>
                      {role.summary && <p class="role-desc">{role.summary}</p>}
                    </div>
                  </li>
                ))}
              </ul>
            )}
          </div>
        </li>
      );
    })
  }
</ol>


<script is:inline>
  // Runs before first paint so entries never flash in and out.
  (() => {
    const list = document.getElementById('timeline');
    if (!list || !('IntersectionObserver' in window)) return;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    // Only animate on the first visit of a session (same idea as the home intro).
    try {
      if (sessionStorage.getItem('journey-seen')) return;
      sessionStorage.setItem('journey-seen', '1');
    } catch {}
    list.classList.add('anim');

    // Entries already on screen at load reveal in sequence; later ones as they scroll in.
    let batch = 0;
    let frame = 0;
    const io = new IntersectionObserver(
      (hits) => {
        for (const hit of hits) {
          if (!hit.isIntersecting) continue;
          hit.target.style.setProperty('--delay', `${batch++ * 110}ms`);
          hit.target.classList.add('in');
          io.unobserve(hit.target);
        }
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(() => (batch = 0));
      },
      { rootMargin: '0px 0px -12% 0px' },
    );
    list.querySelectorAll('.item').forEach((el) => io.observe(el));
    requestAnimationFrame(() => list.classList.add('drawn'));
  })();
</script>

<style>
  .timeline {
    --date-w: 96px;
    --marker: 52px;
    --gap: 20px;
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  /* The vertical line, running through the centre of the markers */
  .timeline::before {
    content: '';
    position: absolute;
    top: calc(var(--marker) / 2);
    bottom: 0;
    left: calc(var(--date-w) + var(--gap) + var(--marker) / 2);
    width: 1px;
    background: var(--line);
  }
  .item {
    position: relative;
    display: grid;
    grid-template-columns: var(--date-w) var(--marker) minmax(0, 1fr);
    column-gap: var(--gap);
    padding-bottom: 52px;
  }
  .item:last-child {
    padding-bottom: 0;
  }

  /* Date block is vertically centred on its circle */
  .when {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    height: var(--marker);
    line-height: 1.2;
    font-family: var(--mono);
    font-size: 13px;
    color: #6b6b67;
    text-align: right;
  }
  .current .when {
    color: var(--ink);
  }

  .marker {
    position: relative;
    width: var(--marker);
    height: var(--marker);
    border-radius: 50%;
    overflow: hidden;
    display: grid;
    place-items: center;
    background: var(--bg);
    border: 1px solid var(--line);
    /* white ring so the line doesn't touch the circle */
    box-shadow: 0 0 0 5px var(--bg);
  }
  .current .marker {
    border-color: color-mix(in srgb, var(--ink) 18%, transparent);
  }
  .logo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .initials {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    background: var(--fill);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.3px;
    color: var(--muted-2);
  }

  .what {
    padding-top: 12px;
  }
  .title {
    font-size: 22px;
    line-height: 1.25;
  }
  .org {
    margin-top: 4px;
    font-size: 14px;
    color: #7c7c78;
  }
  .org a {
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .org a:hover {
    color: var(--ink);
  }
  .desc {
    margin-top: 14px;
    font-family: var(--serif);
    font-size: 17px;
    line-height: 1.5;
    color: var(--ink-soft);
  }
  .desc:empty {
    display: none;
  }
  .desc > :global(*) {
    margin: 0;
  }
  .desc > :global(* + *) {
    margin-top: 10px;
  }
  .desc :global(ul) {
    list-style: disc;
    padding-left: 1.1em;
  }
  .desc :global(li + li) {
    margin-top: 4px;
  }

  /* Work samples: thumbnail + caption, linking out to YouTube */
  .media {
    list-style: none;
    margin: 18px 0 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  .sample {
    display: grid;
    grid-template-columns: 136px minmax(0, 1fr);
    column-gap: 14px;
    align-items: center;
    text-decoration: none;
  }
  .video {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    border-radius: 8px;
    overflow: hidden;
    background: var(--fill);
    box-shadow: 0 0 0 1px var(--line);
  }
  .video img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .sample:hover .video img {
    transform: scale(1.04);
  }
  .play {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 28px;
    height: 28px;
    margin: -14px 0 0 -14px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.92);
    color: var(--ink);
    box-shadow: 0 2px 10px rgb(0 0 0 / 0.18);
    transition: transform 0.2s ease;
  }
  .play svg {
    margin-left: 1px;
  }
  .sample:hover .play {
    transform: scale(1.1);
  }
  .caption {
    font-size: 14px;
    line-height: 1.45;
    color: #6b6b67;
    text-wrap: pretty;
    transition: color 0.15s ease;
  }
  .sample:hover .caption {
    color: var(--ink);
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Grouped roles (e.g. internships) */
  .roles {
    list-style: none;
    margin: 18px 0 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  .role {
    display: grid;
    grid-template-columns: 28px minmax(0, 1fr);
    column-gap: 12px;
  }
  .role-logo {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    overflow: hidden;
    border: 1px solid var(--line);
    display: grid;
    place-items: center;
  }
  .role-logo .initials {
    font-size: 10px;
  }
  .role-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    column-gap: 12px;
    min-height: 28px;
    align-content: center;
  }
  .role-org {
    font-size: 15px;
    font-weight: 500;
    color: var(--ink);
  }
  .role-org a {
    text-decoration: none;
  }
  .role-org a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .role-when {
    font-family: var(--mono);
    font-size: 12px;
    color: #7c7c78;
  }
  .role-desc {
    margin-top: 2px;
    font-family: var(--serif);
    font-size: 17px;
    line-height: 1.5;
    color: var(--ink-soft);
  }

  /* ---- Motion (only when JS has enabled it and the user allows motion) ---- */
  .anim::before {
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 1.4s cubic-bezier(0.65, 0, 0.35, 1) 0.1s;
  }
  .anim.drawn::before {
    transform: scaleY(1);
  }
  .anim .item > * {
    opacity: 0;
    transition:
      opacity 0.7s ease,
      transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
    transition-delay: var(--delay, 0ms);
  }
  .anim .when,
  .anim .what {
    transform: translateY(14px);
  }
  .anim .marker {
    transform: scale(0.82);
  }
  .anim .what {
    transition-delay: calc(var(--delay, 0ms) + 80ms);
  }
  .anim .item.in > * {
    opacity: 1;
    transform: none;
  }
  .anim .role {
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 0.5s ease,
      transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
    transition-delay: calc(var(--delay, 0ms) + 260ms + var(--i) * 90ms);
  }
  .anim .item.in .role {
    opacity: 1;
    transform: none;
  }

  @media (max-width: 560px) {
    .sample {
      grid-template-columns: 112px minmax(0, 1fr);
      column-gap: 12px;
    }
    .caption {
      font-size: 13px;
    }
  }

  /* Phone: markers on the left, dates above each entry */
  @media (max-width: 640px) {
    .timeline {
      --date-w: 0px;
      --gap: 16px;
    }
    .timeline::before {
      left: calc(var(--marker) / 2);
    }
    .item {
      grid-template-columns: var(--marker) minmax(0, 1fr);
      grid-template-areas:
        'marker when'
        '. what';
      padding-bottom: 44px;
    }
    .marker {
      grid-area: marker;
    }
    .when {
      grid-area: when;
      flex-direction: row;
      justify-content: flex-start;
      align-items: center;
      gap: 6px;
      text-align: left;
    }
    .what {
      grid-area: what;
      padding-top: 10px;
    }
  }
</style>
