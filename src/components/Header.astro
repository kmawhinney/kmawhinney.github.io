---
import Mark from './Mark.astro';
import { SITE } from '../lib/site';

const nav = [
  { label: 'Journey', href: '/journey' },
  { label: 'Insights', href: '/insights' },
];

const path = Astro.url.pathname.replace(/\/$/, '');
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---

<header>
  <a href="/" class="brand" aria-label={`${SITE.name}, home`}>
    <Mark />
    <span>{SITE.name}</span>
  </a>
  <nav aria-label="Main">
    {
      nav.map((item) => (
        <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))
    }
  </nav>
</header>

<style>
  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 30px 40px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    font-family: 'Instrument Serif', var(--serif);
    font-size: 24px;
    font-weight: 400;
    letter-spacing: 0.2px;
    line-height: 1;
    /* Instrument Serif has no bold cut; thicken the strokes instead */
    -webkit-text-stroke: 0.6px currentColor;
  }
  nav {
    display: flex;
    gap: 52px;
  }
  nav a {
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.1px;
    text-decoration: none;
    color: var(--muted-2);
    transition: color 0.15s ease;
  }
  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--ink);
  }
  @media (max-width: 720px) {
    header {
      padding: 22px 24px;
    }
    nav {
      gap: 22px;
    }
  }
  @media (max-width: 420px) {
    .brand span {
      display: none;
    }
  }
</style>
