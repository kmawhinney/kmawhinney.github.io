---
import { SITE } from '../lib/site';
---

<footer>
  {SITE.links.map((link) => <a href={link.href} target="_blank" rel="noopener me">{link.label}</a>)}
</footer>

<style>
  footer {
    display: flex;
    justify-content: flex-end;
    flex-wrap: wrap;
    gap: 30px;
    padding: 28px 32px;
  }
  a {
    font-size: 13.5px;
    color: var(--muted-2);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  a:hover {
    color: var(--ink);
  }
  @media (max-width: 720px) {
    footer {
      justify-content: flex-start;
      padding: 28px 24px;
    }
  }
</style>
