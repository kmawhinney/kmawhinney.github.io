---
// Insights list: date on the left, title on the right, hairline between rows.
import type { CollectionEntry } from 'astro:content';
import { formatShortDate } from '../lib/site';

interface Props {
  posts: CollectionEntry<'insights'>[];
}

const { posts } = Astro.props;
---

<ul class="posts">
  {
    posts.map((post, i) => (
      <li style={`--i:${i}`}>
        <a class="post" href={`/insights/${post.id}`}>
          <time datetime={post.data.date.toISOString()}>{formatShortDate(post.data.date)}</time>
          <span class="title">
            {post.data.title}
            {post.data.draft && <span class="draft">Draft</span>}
          </span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .posts {
    list-style: none;
    margin: 0 -16px;
    padding: 0;
  }
  li {
    position: relative;
  }
  /* Hairline between rows, inset to line up with the text */
  li + li::before {
    content: '';
    position: absolute;
    top: 0;
    left: 16px;
    right: 16px;
    height: 1px;
    background: var(--line);
    transition: opacity 0.2s ease;
  }
  /* Hide the lines touching the hovered card */
  li:hover::before,
  li:hover + li::before {
    opacity: 0;
  }
  .post {
    display: grid;
    grid-template-columns: 136px minmax(0, 1fr);
    column-gap: 16px;
    align-items: baseline;
    padding: 22px 16px;
    border-radius: 12px;
    text-decoration: none;
    color: var(--ink);
    transition:
      background-color 0.2s ease,
      transform 0.2s ease;
  }
  .post:hover {
    background: var(--fill);
  }
  .post:active {
    transform: scale(0.995);
  }
  .post:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }
  time {
    font-size: 14px;
    color: #7c7c78;
    font-variant-numeric: tabular-nums;
  }
  .title {
    font-family: var(--serif);
    font-size: 19px;
    line-height: 1.35;
    max-width: 460px;
    text-wrap: balance;
  }

  /* Only ever visible in dev: drafts are excluded from the live build */
  .draft {
    display: inline-block;
    margin-left: 8px;
    padding: 2px 7px;
    border-radius: 6px;
    background: #fdf1d8;
    color: #8a5a00;
    font-family: var(--sans);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.2px;
    vertical-align: 3px;
  }

  @media (max-width: 560px) {
    .post {
      grid-template-columns: 1fr;
      row-gap: 4px;
      padding: 18px 16px;
    }
    time {
      font-size: 13px;
    }
    .title {
      font-size: 18px;
    }
  }
</style>
